ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
APP_BASE_URL=http://localhost:3000
SHOPIFY_STORE_DOMAIN=            # optional, e.g. my-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=      # optional, custom app token
SHOPIFY_API_VERSION=2026-10      # latest stable Admin API version as of 2026-10-15 (Shopify releases quarterly)
REMOVE_BG_PROVIDER=none
REMOVE_BG_API_KEY=
MAX_UPLOAD_MB=15

# --- Optional (sensible defaults are used when unset) ---
# SQLite database file (relative paths resolve from the project root)
DATABASE_URL=file:./data/storeforge.db
# AI_MODE=live (default) uses the Anthropic API; AI_MODE=fixture uses deterministic offline fixtures (tests/demo)
AI_MODE=live
# Delete project data older than this many days (cleanup runs at startup and daily)
DATA_RETENTION_DAYS=30
# Public base URL used in "Public URL mode" CSV image links (defaults to APP_BASE_URL)
PUBLIC_IMAGE_BASE_URL=
# Comma-separated host:port pairs the scraper may fetch even though they are private (dev/test fixtures ONLY)
SCRAPE_ALLOWLIST=
# Download Google Fonts (TTF) to draw the logo wordmark as outlines; "off" falls back to live SVG text
FONT_DOWNLOADS=on
# Encrypts the session-only Shopify token cookie (32+ random characters). When unset, a random key is
# generated at startup, so tokens entered in the app are forgotten when the server restarts.
SESSION_SECRET=
# ZIP of Dawn used when "Push to Shopify" creates a new unpublished theme (defaults to Dawn v16.0.0 on GitHub)
SHOPIFY_THEME_SOURCE_URL=
